# Copy to .env and adjust for your environment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_dba
DB_USER=ai_dba_readonly
DB_PASSWORD=readonly_password

# Execution guards.
STATEMENT_TIMEOUT_MS=3000
MAX_ROWS=200
APPLICATION_NAME=ai-dba-mcp

# LLM selection (auto | anthropic | openai | ollama).
AI_DBA_LLM=auto

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- OpenAI (also works with Azure OpenAI / LM Studio / vLLM via OPENAI_BASE_URL) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# --- Ollama (local, no key needed) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
